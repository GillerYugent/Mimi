# Shared across services
JWT_SECRET=change-me-in-production-please-32-bytes-minimum
ACCESS_TTL=15m
REFRESH_TTL=168h
BCRYPT_COST=12
LOG_LEVEL=info

# Per-service DATABASE_URL is set inside docker-compose.yml.
# Example for local non-docker runs:
# DATABASE_URL=postgres://mimi:mimi@localhost:5432/mimi_users?sslmode=disable
# REDIS_URL=redis://localhost:6379/0
